; Engine configuration file.
; 《定风波》 — 水墨侠客 · 燕云风格
; Godot 4.3

config_version=5

[application]

config/name="定风波"
config/description="莫听穿林打叶声，何妨吟啸且徐行。"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.08, 0.086, 0.094, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout=""

[display]

; 横屏 1280×720（16:9）—— 横版动作游戏必须横屏：
; 竖屏下横向可视宽度不够装下一次进退，角色要么太小要么看不到敌人。
; 配合 stretch/aspect="expand" 在不同手机上自适应。
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 屏幕方向：0 = LANDSCAPE（横屏）。
; 注意 Godot 取值对应 DisplayServer::ScreenOrientation：
;   0=LANDSCAPE 1=PORTRAIT 2=REVERSE_LANDSCAPE 3=REVERSE_PORTRAIT
;   4=SENSOR 5=SENSOR_LANDSCAPE 6=SENSOR_PORTRAIT
; SENSOR_LANDSCAPE(5) 更友好，但部分老 Android 设备导出器会翻成 screenOrientation=6 反而错乱 —— 保守用 0。
window/handheld/orientation=0
; 必须为 false：为 true 时 Android resizeableActivity 会是 true，
; 分屏/折叠屏下系统会无视 screenOrientation。
window/size/resizable=false

